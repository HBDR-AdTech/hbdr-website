{
  "name": "hbdr-website",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npx @tailwindcss/cli -i src/styles/main.css -o public/assets/styles.css --watch & NODE_ENV=development tsx server/index.ts",
    "css:build": "npx @tailwindcss/cli -i src/styles/main.css -o public/assets/styles.css --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "deploy": "npm run css:build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "zod": "^4.6.5",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@hono/node-server": "^2.1.3",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.19.1",
    "daisyui": "^5.7.47",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
